{
  "name": "omatech/editora-extractor",
  "description": "Extract information from Editora in powerful and misterious ways using Facebook GraphQL",
  "minimum-stability": "dev",
  "require": {
    "php": "^8.2",
    "doctrine/dbal": "^3.9 || ^4.0",
    "webonyx/graphql-php": "^15.0"
  },
  "require-dev": {
    "phpunit/phpunit": "13.4.6"
  },
  "autoload": {
    "psr-4": {
      "Omatech\\": "src/Omatech"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.12"
    },
    "allow-plugins": false,
    "sort-packages": true,
    "github-protocols": [
      "https"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@test",
      "@composer validate --no-check-publish",
      "@composer audit --locked"
    ]
  }
}
